@model CRUDALNT1.Models.Aluno

@{
    ViewData["Title"] = "Details";
}

    <h2 class="fw-bold text-primary mb-0">Detalhes de Aluno</h2>


<div>

    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.idade)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.idade)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.curso)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.curso.area)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.nota)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.nota)
        </dd>
    </dl>
</div>
<div>
    <button type="button" class="btn btn-warning" onclick="window.location.href='@Url.Action("Edit", new { id = Model?.id })'">
            <i class="bi bi-pencil-fill"></i> Editar
    </button>
    <button type="button" class="btn btn-secondary" onclick="window.location.href='@Url.Action("Index")'">
                    <i class="bi bi-arrow-left"></i> Voltar
     </button>
</div>
