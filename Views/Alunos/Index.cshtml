@model IEnumerable<CRUDALNT1.Models.Aluno>

@{
    ViewData["Title"] = "Index";
}

    <h2 class="fw-bold text-primary mb-0">Lista de Alunos</h2>
    <hr />

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.idade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.curso)
            </th>
            <th>
                Sigla
            </th>
            <th>
                @Html.DisplayNameFor(model => model.nota)
            </th>
            <th>
            <a href="@Url.Action("Create")"
       class="btn btn-sm btn-outline-success"
       title="Novo">
        Operações <i class="bi bi-plus"></i>
    </a>
            
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.idade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.curso.descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.curso.sigla)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.nota)
            </td>
@*             <td>
                <a asp-action="Edit" asp-route-id="@item.id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.id">Delete</a>
            </td> *@

<td class="text-center" style="width: 160px;">
    <a href="@Url.Action("Edit", "Alunos", new { id = item.id })"
       class="btn btn-sm btn-outline-primary me-1"
       title="Editar">
        <i class="bi bi-pencil-fill"></i>
    </a>
    <a href="@Url.Action("Details", "Alunos", new { id = item.id })"
       class="btn btn-sm btn-outline-info me-1"
       title="Detalhes">
        <i class="bi bi-eye-fill"></i>
    </a>
    <a href="@Url.Action("Delete", "Alunos", new { id = item.id })"
       class="btn btn-sm btn-outline-danger"
       title="Excluir">
        <i class="bi bi-trash-fill"></i>
    </a>
</td>

        </tr>
}
    </tbody>
</table>
